# Copy this file to secrets.env (same folder) and paste your real key.
# secrets.env is gitignored — it will never reach the repository.
# Resolution order for every agent in this workspace:
#   1. environment variable CLEANAPIS_KEY
#   2. this file (secrets.env)
#   3. /home/z/my-project/.env
# Get your key at: https://cleanapis.com/dashboard/api-keys
CLEANAPIS_KEY=paste-your-cleanapis-key-here

# Optional per-stage model overrides (defaults shown; any of the 33
# catalog skus is valid — see config.py CLEANAPIS_CATALOG):
# CLEANAPIS_MODEL_WRITER=deepseek-v4-pro-0813
# CLEANAPIS_MODEL_TRANSLATOR=glm-5.3
# CLEANAPIS_MODEL_FAST=gpt-5.6-luna
# CLEANAPIS_MODEL_HEAVY=claude-sonnet-5
