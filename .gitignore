# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

google-indexing-key.json

# Environment files — never commit real environment configuration.
# .env can hold Supabase service-role keys, AI provider keys, or other
# secrets that must never reach a public repo even though the publishable
# anon key is also inlined into the client bundle via VITE_* variables.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
google-indexing-key.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
service-account.json
google-services.json
__pycache__/

# Generated modern image variants are created by the prebuild optimizer
public/**/*.avif
public/**/*.webp
